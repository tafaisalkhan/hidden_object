; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="difference find"
run/main_scene="res://main/splash_screen.tscn"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.04, 0.06, 0.12, 1)
boot_splash/image="res://assets/main/app_splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/icon="res://icon.svg"
config/admob_app_id="ca-app-pub-1852108665659812~9828050799"

[autoload]

SignalHub="*res://autoloads/signal_hub.gd"
GameManager="*res://autoloads/game_manager.gd"
MusicManager="*res://autoloads/music_manager.gd"
InAppPurchaseManager="*res://autoloads/in_app_purchase_manager.gd"
AdManager="*res://autoloads/ad_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation="portrait"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
